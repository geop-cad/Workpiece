# Cloudflare Pages' response headers (https://developers.cloudflare.com/pages/configuration/headers/),
# copied to the site's root by assemble.sh. Pages already answers every file with an ETag and
# "Cache-Control: public, max-age=0, must-revalidate", so a browser asks again on each visit and
# gets a 304 (no download) when the file did not change. Only names that never change their
# contents may be cached for longer. (Where two rules set the same header, Pages joins their
# values: no two rules here may both set Cache-Control on one file.)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/app/*.wasm
  Content-Type: application/wasm

# The application is cross-origin isolated: its build threads are Web Workers that share the
# page's memory (app/thread.js, hosts/app/src/web.rs), which a browser allows only then. Every
# file under /app/ (the page, its workers' scripts) says so; what it loads from elsewhere must
# allow it (Cloudflare's Turnstile, for the assistant). Without these, Chrome and Firefox still
# run it, building on the page's one thread (Safari may not start it at all). (One rule only:
# Pages would join two rules' values.)
/app/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The program, named by its contents (app/build.sh): a new build is a new name, which the page
# (revalidated, as everything else) names; the files themselves are kept for good.
/app/workpiece-*.js
  Cache-Control: public, max-age=31536000, immutable

/app/workpiece_bg-*.wasm
  Cache-Control: public, max-age=31536000, immutable

# The home page's pictures: a day-old screenshot breaks nothing.
/assets/*
  Cache-Control: public, max-age=86400

# The assistant's Python worker runs scripts a model wrote: it may load only what our own site
# serves and may connect nowhere else (the worker also removes its network functions after
# start-up; this header closes what script cannot: import()).
/app/assistant/worker.js
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'

# Pyodide's files change only when its pinned version does: a day's cache spares a returning
# visitor a round of checks on some 13 MB of files.
/app/assistant/pyodide/*
  Cache-Control: public, max-age=86400
